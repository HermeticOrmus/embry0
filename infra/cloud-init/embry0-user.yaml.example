#cloud-config
# Example cloud-init for an embry0 host.
#
# Copy this file onto the hypervisor snippets directory and point the VM's
# cicustom user-data at that copy. Set hostname to this machine's name.
hostname: embry0
fqdn: embry0.example.com
preserve_hostname: false
users:
  - name: embry0
    shell: /bin/bash
    groups: [sudo]
    sudo: ['ALL=(ALL) NOPASSWD:ALL']
    lock_passwd: true
    # The operator fills this list.
    ssh_authorized_keys: []
package_update: true
packages:
  - qemu-guest-agent
  - prometheus-node-exporter
  - docker.io
  - docker-compose-v2
  - git
  - curl
  - ca-certificates
# The sandbox isolation chain needs br_netfilter: without it iptables in DinD
# does not see traffic between containers on one bridge, and embry0 refuses
# to create any sandbox. Loaded now and at every boot.
write_files:
  - path: /etc/modules-load.d/br_netfilter.conf
    content: |
      br_netfilter
runcmd:
  - modprobe br_netfilter
  - systemctl enable --now qemu-guest-agent
  - systemctl enable --now docker
  - systemctl enable --now prometheus-node-exporter
  - usermod -aG docker embry0
