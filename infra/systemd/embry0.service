[Unit]
# Bring the compose stack back after a reboot.
Description=embry0 compose stack
Requires=docker.service
After=docker.service network-online.target
Wants=network-online.target

[Service]
Type=oneshot
RemainAfterExit=yes
User=embry0
# The operator must match this path to the checkout's infra directory.
# Compose reads infra/.env there (infra/.env.example), and starts the optional
# services, such as the webhook tunnel, only for the profiles its
# COMPOSE_PROFILES lists.
WorkingDirectory=/opt/embry0/infra
ExecStart=/usr/bin/docker compose up -d
ExecStop=/usr/bin/docker compose down
# Image pulls and first-run builds can take a long while; do not time them out.
TimeoutStartSec=0

[Install]
WantedBy=multi-user.target
